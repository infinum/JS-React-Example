{
	"$schema": "https://turbo.build/schema.json",
	"ui": "stream",
	"tasks": {
		"build": {
			"dependsOn": ["^build"]
		},
		"@infinum/frontend#build": {
			"dependsOn": ["^build"],
			"inputs": [
				"$TURBO_DEFAULT$",
				".env*",
				"../../packages/ui/src/**",
				"!../../packages/ui/src/**/*.{stories,test}.{ts,tsx}"
			],
			"outputs": [".next/**", "!.next/cache/**"]
		},
		"@infinum/storybook#build": {
			"dependsOn": ["^build"],
			"inputs": ["$TURBO_DEFAULT$", "../../packages/ui/src/**", "!../../packages/ui/src/**/*.test.{ts,tsx}"],
			"outputs": ["storybook-static/**"]
		},
		"clean": {
			"cache": false
		},
		"dev": {
			"cache": false,
			"persistent": true
		},
		"lint": {
			"inputs": ["$TURBO_DEFAULT$", "../../packages/configs/src/eslint-config/**"]
		},
		"@infinum/frontend#lint": {
			"dependsOn": ["typegen"],
			"inputs": ["$TURBO_DEFAULT$", "../../packages/configs/src/eslint-config/**", "../../packages/ui/src/**"]
		},
		"@infinum/storybook#lint": {
			"inputs": ["$TURBO_DEFAULT$", "../../packages/configs/src/eslint-config/**", "../../packages/ui/src/**"]
		},
		"lint:fix": {
			"inputs": ["$TURBO_DEFAULT$", "../../packages/configs/src/eslint-config/**"]
		},
		"//#lint:root": {
			"inputs": ["$TURBO_DEFAULT$", "!apps/**", "!packages/**", "./packages/configs/**"]
		},
		"//#lint:fix:root": {
			"inputs": ["$TURBO_DEFAULT$", "!apps/**", "!packages/**", "./packages/configs/**"]
		},
		"typecheck": {
			"inputs": ["$TURBO_DEFAULT$", "!**/*.tsbuildinfo"]
		},
		"@infinum/frontend#typecheck": {
			"dependsOn": ["typegen"],
			"inputs": ["$TURBO_DEFAULT$", "!.next/**", "!**/*.tsbuildinfo", "../../packages/ui/src/**"]
		},
		"@infinum/storybook#typecheck": {
			"inputs": ["$TURBO_DEFAULT$", "!**/*.tsbuildinfo", "../../packages/ui/src/**"]
		},
		"@infinum/frontend#typegen": {
			"inputs": ["$TURBO_DEFAULT$", "!.next/**"],
			"outputs": [".next/types/**", ".next/dev/types/**", "next-env.d.ts"]
		},
		"//#test:root": {
			"inputs": ["scripts/**", "lint-staged.config.js"]
		},
		"prettier:check": {},
		"prettier:fix": {},
		"//#prettier:check:root": {
			"inputs": ["$TURBO_DEFAULT$", "!apps/**", "!packages/**", "./packages/configs/**"]
		},
		"//#prettier:fix:root": {
			"inputs": ["$TURBO_DEFAULT$", "!apps/**", "!packages/**", "./packages/configs/**"]
		},
		"test": {
			"inputs": ["$TURBO_DEFAULT$", "../../packages/configs/src/vitest-config/**"],
			"env": ["TEST_REPORT"],
			"outputs": ["../../test-results/**"]
		},
		"@infinum/frontend#test": {
			"inputs": ["$TURBO_DEFAULT$", "../../packages/configs/src/vitest-config/**", "../../packages/ui/src/**"],
			"env": ["TEST_REPORT"],
			"outputs": ["../../test-results/frontend/**"]
		},
		"@infinum/ui#test": {
			"inputs": ["$TURBO_DEFAULT$", "../../packages/configs/src/vitest-config/**"],
			"env": ["TEST_REPORT"],
			"outputs": ["../../test-results/ui/**"]
		},
		"@infinum/storybook#test": {
			"inputs": ["$TURBO_DEFAULT$", "../../packages/configs/src/vitest-config/**", "../../packages/ui/src/**"],
			"env": ["TEST_REPORT"],
			"outputs": ["../../test-results/storybook/**"]
		},
		"test:watch": {
			"cache": false,
			"persistent": true
		},
		"test:changed": {
			"cache": false,
			"passThroughEnv": ["TEST_CHANGED_BASE", "TEST_REPORT"]
		},
		"test:coverage": {
			"inputs": ["$TURBO_DEFAULT$", "../../packages/configs/src/vitest-config/**"],
			"env": ["TEST_REPORT"],
			"outputs": ["../../test-results/**", "../../coverage/**"]
		},
		"@infinum/frontend#test:coverage": {
			"inputs": ["$TURBO_DEFAULT$", "../../packages/configs/src/vitest-config/**", "../../packages/ui/src/**"],
			"env": ["TEST_REPORT"],
			"outputs": ["../../test-results/frontend/**", "../../coverage/frontend/**"]
		},
		"@infinum/ui#test:coverage": {
			"inputs": ["$TURBO_DEFAULT$", "../../packages/configs/src/vitest-config/**"],
			"env": ["TEST_REPORT"],
			"outputs": ["../../test-results/ui/**", "../../coverage/ui/**"]
		},
		"@infinum/storybook#test:coverage": {
			"inputs": ["$TURBO_DEFAULT$", "../../packages/configs/src/vitest-config/**", "../../packages/ui/src/**"],
			"env": ["TEST_REPORT"],
			"outputs": ["../../test-results/storybook/**", "../../coverage/storybook/**"]
		},
		"test:coverage:changed": {
			"cache": false,
			"passThroughEnv": ["TEST_CHANGED_BASE", "TEST_REPORT"]
		},
		"test:coverage:watch": {
			"cache": false,
			"persistent": true
		},
		"start": {
			"dependsOn": ["^build"],
			"cache": false,
			"persistent": true
		},
		"check-licenses": {
			"cache": false
		},
		"//#check-licenses:root": {
			"cache": false
		},
		"e2e": {
			"dependsOn": ["^build"],
			"cache": false,
			"inputs": [
				"$TURBO_DEFAULT$",
				"**/*.e2e.{spec,test}.{ts,tsx,js,jsx}",
				"../../packages/e2e-utils/src/**/*.{ts,js}",
				"../../packages/configs/src/playwright-config/**/*.{js,ts}"
			]
		},
		"e2e:report": {
			"dependsOn": ["^e2e"],
			"cache": false
		},
		"e2e:install": {
			"cache": false
		}
	}
}
