{
	"compilerOptions": {
		"target": "ES2017",
		"lib": ["dom", "dom.iterable", "esnext"],
		"allowJs": true,
		"skipLibCheck": true,
		"strict": true,
		"noEmit": true,
		"jsx": "react-jsx",
		"esModuleInterop": true,
		"module": "esnext",
		"moduleResolution": "bundler",
		"resolveJsonModule": true,
		"isolatedModules": true,
		"paths": {
			"@infinum/ui/*": ["./src/*"]
		}
	},
	"include": ["src", "*.mts", "*.mjs", ".prettierrc.js"],
	"exclude": ["node_modules"]
}
