{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"allowJs": true,
		"moduleResolution": "bundler",
		"declaration": true,
		"declarationMap": true,
		"outDir": "./dist"
	},
	"include": [
		"src/index.ts",
		"src/accessibility/**/*.ts",
		"src/devices/**/*.ts",
		"src/pages/**/*.ts",
		"src/reports/**/*.ts",
		"src/utils/**/*.ts"
	],
	"exclude": ["node_modules", "dist"]
}
