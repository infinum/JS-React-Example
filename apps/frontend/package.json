{
	"name": "@infinum/frontend",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"build": "next build",
		"build:analyze": "ANALYZE=true pnpm build",
		"check-licenses": "node ../../scripts/check-licenses-workspace.js",
		"clean": "rm -rf node_modules .turbo .next .eslintcache",
		"dev": "NODE_OPTIONS='--inspect' next dev",
		"lint": "eslint . --max-warnings 0",
		"lint:fix": "eslint . --fix",
		"prettier:check": "prettier --check .",
		"prettier:fix": "prettier --write .",
		"start": "next start",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"test:coverage:changed": "COVERAGE_CHANGED=${TEST_CHANGED_BASE:-origin/main} vitest run --coverage",
		"test:coverage:watch": "vitest --coverage",
		"test:changed": "vitest run --changed ${TEST_CHANGED_BASE:-origin/main}",
		"typegen": "next typegen",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@infinum/ui": "workspace:*",
		"@tailwindcss/postcss": "catalog:",
		"envsafe": "catalog:",
		"next": "catalog:",
		"next-auth": "catalog:",
		"next-intl": "catalog:",
		"next-public-env": "1.1.0",
		"next-themes": "catalog:",
		"postcss": "catalog:",
		"react": "catalog:",
		"react-dom": "catalog:",
		"server-only": "catalog:",
		"tailwindcss": "catalog:"
	},
	"devDependencies": {
		"@infinum/configs": "workspace:*",
		"@next/bundle-analyzer": "catalog:",
		"@testing-library/dom": "catalog:",
		"@testing-library/jest-dom": "catalog:",
		"@testing-library/react": "catalog:",
		"@types/node": "catalog:",
		"@types/react": "catalog:",
		"@types/react-dom": "catalog:",
		"@vitest/coverage-v8": "catalog:",
		"jsdom": "catalog:",
		"prettier": "catalog:",
		"prettier-plugin-sh": "catalog:",
		"prettier-plugin-tailwindcss": "catalog:",
		"typescript": "catalog:",
		"vite": "catalog:",
		"vitest": "catalog:"
	}
}
