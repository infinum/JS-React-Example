{
	"name": "@infinum/storybook",
	"version": "0.0.0",
	"private": true,
	"scripts": {
		"build": "storybook build",
		"check-licenses": "node ../../scripts/check-licenses-workspace.js",
		"clean": "rm -rf node_modules .turbo storybook-static .eslintcache",
		"dev": "storybook dev -p 6006",
		"lint": "eslint . --cache",
		"lint:fix": "eslint . --cache --fix",
		"prettier:check": "prettier --check .",
		"prettier:fix": "prettier --write .",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"test:coverage:watch": "vitest --coverage",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@infinum/ui": "workspace:*",
		"react": "catalog:",
		"react-dom": "catalog:",
		"tailwindcss": "catalog:"
	},
	"devDependencies": {
		"@infinum/configs": "workspace:*",
		"@storybook/addon-a11y": "catalog:",
		"@storybook/addon-designs": "catalog:",
		"@storybook/addon-docs": "catalog:",
		"@storybook/addon-mcp": "catalog:",
		"@storybook/addon-themes": "catalog:",
		"@storybook/addon-vitest": "catalog:",
		"@storybook/nextjs-vite": "catalog:",
		"@tailwindcss/postcss": "catalog:",
		"@types/react": "catalog:",
		"@types/react-dom": "catalog:",
		"@vitest/browser": "catalog:",
		"@vitest/browser-playwright": "catalog:",
		"@vitest/coverage-v8": "catalog:",
		"eslint-plugin-storybook": "catalog:",
		"next": "catalog:",
		"playwright": "catalog:",
		"prettier": "catalog:",
		"prettier-plugin-sh": "catalog:",
		"prettier-plugin-tailwindcss": "catalog:",
		"storybook": "catalog:",
		"typescript": "catalog:",
		"vite": "catalog:",
		"vitest": "catalog:"
	}
}
